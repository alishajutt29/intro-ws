<%= form_with model: product do |form| %>
  <% if form.object.errors.any? %>
    <p class="error">
      <%= form.object.errors.full_messages.first %>
    </p>
  <% end %>

  <div>
    <%= form.label :name, "Product Name" %>
    <%= form.text_field :name, placeholder: "Enter product name" %>
  </div>

  <div>
    <%= form.label :category_id, "Category" %>
    <%= form.collection_select :category_id, Category.order(:name), :id, :name, { prompt: "Select Category" } %>
  </div>

  <div>
    <%= form.label :description, "Product Description" %>
    <%= form.rich_textarea :description %>
  </div>
<div>
  <%= form.label :featured_image, "Product Image" %>
  <%= form.file_field :featured_image, accept: "image/*" %>
</div>
<div>
  <%= form.label :inventory_count, "Stock Quantity" %>
  <%= form.number_field :inventory_count %>
</div>
  <div>
    <%= form.submit "Save Product" %>
  </div>
<% end %>